{
  "uid": "beacon-device-detail",
  "title": "Device Detail",
  "tags": [
    "beacon"
  ],
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "serial",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "beacon-vm"
        },
        "query": "label_values(stick_uptime_seconds, serial)",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "logsource",
        "label": "Log source",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "beacon-loki"
        },
        "query": "label_values(source)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": true
        },
        "options": []
      },
      {
        "name": "loglevel",
        "label": "Level",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "beacon-loki"
        },
        "query": "label_values(level)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": true
        },
        "options": []
      },
      {
        "name": "grep",
        "label": "Text filter (regex)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*",
          "selected": false
        },
        "options": [
          {
            "text": ".*",
            "value": ".*",
            "selected": true
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "creative change",
        "datasource": {
          "type": "loki",
          "uid": "beacon-loki"
        },
        "enable": true,
        "iconColor": "#3E7BD6",
        "expr": "{serial=\"$serial\", source=\"events\"} |= \"creative_change\""
      },
      {
        "name": "GPU fault",
        "datasource": {
          "type": "prometheus",
          "uid": "beacon-vm"
        },
        "enable": true,
        "iconColor": "#C4432B",
        "expr": "increase(stick_gpu_faults_total{serial=\"$serial\"}[1m]) > 0",
        "titleFormat": "GPU fault: {{type}}"
      },
      {
        "name": "reboot",
        "datasource": {
          "type": "prometheus",
          "uid": "beacon-vm"
        },
        "enable": true,
        "iconColor": "#CC6F2B",
        "expr": "increase(stick_reboots_total{serial=\"$serial\"}[5m]) > 0",
        "titleFormat": "reboot: {{reason}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "GPU pages \u2014 app (raw 1 Hz + rolling max envelope)",
      "description": "The ENVELOPE is the leak signal (plan.md \u00a71.4). The raw series is a \u00b115% sawtooth from the WebView ping-pong; never judge a trend from it over minutes.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "beacon-vm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": 120000
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3E7BD6"
          },
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "rolling max 30m"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3E7BD6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "raw 1 Hz"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#9BBCE8"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "stick_gpu_pages{serial=\"$serial\",proc=\"dplayer\"}",
          "legendFormat": "raw 1 Hz"
        },
        {
          "refId": "B",
          "expr": "max_over_time(stick_gpu_pages{serial=\"$serial\",proc=\"dplayer\"}[30m])",
          "legendFormat": "rolling max 30m"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Thermal zones",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "beacon-vm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#C4432B",
                "value": 65
              }
            ]
          },
          "unit": "celsius"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "soc"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3E7BD6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ddr"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#CC6F2B"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "stick_temp_celsius{serial=\"$serial\"}",
          "legendFormat": "{{zone}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "beacon-vm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "MemAvailable"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3E7BD6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CmaFree"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#CC6F2B"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "stick_mem_available_bytes{serial=\"$serial\"}",
          "legendFormat": "MemAvailable"
        },
        {
          "refId": "B",
          "expr": "stick_cma_free_bytes{serial=\"$serial\"}",
          "legendFormat": "CmaFree"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Heartbeat age (ReactNativeJS)",
      "description": "Stall threshold 30 s (plan.md \u00a71.8): median gap 2 ms, max observed 3 s.",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "beacon-vm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#C4432B",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3E7BD6"
          },
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "stick_heartbeat_age_seconds{serial=\"$serial\"}",
          "legendFormat": "heartbeat age"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Load average (4 cores)",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "beacon-vm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "1m"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#9BBCE8"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5m"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5E93DE"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "15m"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3E7BD6"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "stick_loadavg{serial=\"$serial\"}",
          "legendFormat": "{{window}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Network (wlan0)",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "beacon-vm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "unit": "Bps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "rx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3E7BD6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#CC6F2B"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(stick_net_bytes_total{serial=\"$serial\"}[1m])",
          "legendFormat": "{{dir}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Display liveness (vsync rate) & HDMI",
      "description": "50 Hz panel advances ~22 vsync/s under normal playback (plan.md \u00a71.14). HDMI is the app's own ground truth (\u00a71.9).",
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "beacon-vm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "vsync/s"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3E7BD6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "hdmi connected"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#CC6F2B"
                }
              },
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    4,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(stick_vsync_count_total{serial=\"$serial\"}[2m])",
          "legendFormat": "vsync/s"
        },
        {
          "refId": "B",
          "expr": "stick_hdmi_connected{serial=\"$serial\"}",
          "legendFormat": "hdmi connected"
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Logs \u2014 filter with Log source / Level / Text filter above",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 11
      },
      "datasource": {
        "type": "loki",
        "uid": "beacon-loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "maxLines": 2000
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{serial=\"$serial\", source=~\"$logsource\", level=~\"$loglevel\"} |~ \"$grep\""
        }
      ]
    }
  ]
}