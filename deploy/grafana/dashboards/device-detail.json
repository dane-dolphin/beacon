{
  "uid": "beacon-device-detail",
  "title": "Device Detail",
  "tags": [
    "beacon"
  ],
  "schemaVersion": 39,
  "editable": true,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "serial",
        "label": "Device",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "beacon-vm"
        },
        "query": "label_values(stick_uptime_seconds, serial)",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "logsource",
        "label": "Log source",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "beacon-loki"
        },
        "query": "label_values(source)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": true
        },
        "options": []
      },
      {
        "name": "loglevel",
        "label": "Level",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "beacon-loki"
        },
        "query": "label_values(level)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": true
        },
        "options": []
      },
      {
        "name": "grep",
        "label": "Text filter (regex)",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*",
          "selected": false
        },
        "options": [
          {
            "text": ".*",
            "value": ".*",
            "selected": true
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "creative change",
        "datasource": {
          "type": "loki",
          "uid": "beacon-loki"
        },
        "enable": true,
        "iconColor": "#3E7BD6",
        "expr": "{serial=\"$serial\", source=\"events\"} |= \"creative_change\""
      },
      {
        "name": "GPU fault",
        "datasource": {
          "type": "prometheus",
          "uid": "beacon-vm"
        },
        "enable": true,
        "iconColor": "#C4432B",
        "expr": "increase(stick_gpu_faults_total{serial=\"$serial\"}[1m]) > 0",
        "titleFormat": "GPU fault: {{type}}"
      },
      {
        "name": "reboot",
        "datasource": {
          "type": "prometheus",
          "uid": "beacon-vm"
        },
        "enable": true,
        "iconColor": "#CC6F2B",
        "expr": "increase(stick_reboots_total{serial=\"$serial\"}[5m]) > 0",
        "titleFormat": "reboot: {{reason}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "GPU pages — app (raw 1 Hz + rolling max envelope)",
      "description": "The ENVELOPE is the leak signal (plan.md §1.4). The raw series is a ±15% sawtooth from the WebView ping-pong; never judge a trend from it over minutes.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "beacon-vm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": 120000
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3E7BD6"
          },
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "rolling max 30m"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3E7BD6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "raw 1 Hz"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 1
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#9BBCE8"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "stick_gpu_pages{serial=\"$serial\",proc=\"dplayer\"}",
          "legendFormat": "raw 1 Hz"
        },
        {
          "refId": "B",
          "expr": "max_over_time(stick_gpu_pages{serial=\"$serial\",proc=\"dplayer\"}[30m])",
          "legendFormat": "rolling max 30m"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Thermal zones",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "beacon-vm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#C4432B",
                "value": 65
              }
            ]
          },
          "unit": "celsius"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "soc"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3E7BD6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ddr"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#CC6F2B"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "stick_temp_celsius{serial=\"$serial\"}",
          "legendFormat": "{{zone}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "beacon-vm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "MemAvailable"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3E7BD6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CmaFree"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#CC6F2B"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "stick_mem_available_bytes{serial=\"$serial\"}",
          "legendFormat": "MemAvailable"
        },
        {
          "refId": "B",
          "expr": "stick_cma_free_bytes{serial=\"$serial\"}",
          "legendFormat": "CmaFree"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Heartbeat age (ReactNativeJS)",
      "description": "Stall threshold 30 s (plan.md §1.8): median gap 2 ms, max observed 3 s.",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "beacon-vm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#C4432B",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#3E7BD6"
          },
          "unit": "s"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "stick_heartbeat_age_seconds{serial=\"$serial\"}",
          "legendFormat": "heartbeat age"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Load average (4 cores)",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "beacon-vm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "1m"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#9BBCE8"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5m"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5E93DE"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "15m"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3E7BD6"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "stick_loadavg{serial=\"$serial\"}",
          "legendFormat": "{{window}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Network (wlan0)",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "beacon-vm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          },
          "unit": "Bps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "rx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3E7BD6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "tx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#CC6F2B"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(stick_net_bytes_total{serial=\"$serial\"}[1m])",
          "legendFormat": "{{dir}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Display liveness (vsync rate) & HDMI",
      "description": "50 Hz panel advances ~22 vsync/s under normal playback (plan.md §1.14). HDMI is the app's own ground truth (§1.9).",
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "beacon-vm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "vsync/s"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3E7BD6"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "hdmi connected"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#CC6F2B"
                }
              },
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    4,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(stick_vsync_count_total{serial=\"$serial\"}[2m])",
          "legendFormat": "vsync/s"
        },
        {
          "refId": "B",
          "expr": "stick_hdmi_connected{serial=\"$serial\"}",
          "legendFormat": "hdmi connected"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "RAM by process — top 5 (PSS)",
      "description": "PSS, not RSS: summing RSS double-counts the zygote's shared framework pages and overstates the total. A process whose smaps_rollup is unreadable reports no PSS and is absent here — check the RSS series if something you expect is missing. The top 5 are chosen on-device by rec.sh, so this is not a topk() over all processes and cannot flap. A series that stops (app swapped out) leaves a gap, not a drop to 0.",
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "beacon-vm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 35,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": false
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (proc) (stick_proc_pss_bytes{serial=\"$serial\"})",
          "legendFormat": "{{proc}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "CPU by process — top 5 (% of one core)",
      "description": "Percent of a SINGLE core, so a threaded process legitimately exceeds 100% — the app measured 143% on D-005-02408. Sampled every ~33 s, so short bursts are invisible by design; the 1 Hz per-core stick_cpu_jiffies_total series is where those show up.",
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "beacon-vm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 35,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "spanNulls": false
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (proc) (rate(stick_proc_cpu_seconds_total{serial=\"$serial\"}[2m])) * 100",
          "legendFormat": "{{proc}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Error rate — E/F, including deduplicated",
      "description": "Counts EVERY E/F event, including the ~97% suppressed before Loki — only 3 exemplars per signature ship as text, the rest ride this counter (§3.4 rule 4). So this is the honest error volume, and it is not reproducible by counting rows in Loki. It also outlives Loki's 30-day retention. GPU faults come from the dmesg stream, not logcat.",
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "beacon-vm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(stick_errors_total{serial=\"$serial\"}[5m])) * 60",
          "legendFormat": "errors/min"
        },
        {
          "refId": "B",
          "expr": "sum(rate(stick_gpu_faults_total{serial=\"$serial\"}[5m])) * 60",
          "legendFormat": "GPU faults/min (dmesg)"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Log lines by level",
      "description": "Total logcat volume by level, lines/min. Measured shape on this fleet is ~92.8% level I and 90.6% tag ReactNativeJS, so I dwarfing everything else is normal, not a fault. Watch the ratio change after a build, not the absolute height.",
      "gridPos": {
        "x": 12,
        "y": 42,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "beacon-vm"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 35,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ],
          "sortBy": "Max",
          "sortDesc": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (rate(stick_log_lines_total{serial=\"$serial\"}[5m])) * 60",
          "legendFormat": "{{level}}"
        },
        {
          "refId": "B",
          "expr": "rate(stick_unparsed_lines_total{serial=\"$serial\"}[5m]) * 60",
          "legendFormat": "unparsed"
        }
      ]
    },
    {
      "id": 13,
      "type": "stat",
      "title": "Errors, last 24 h",
      "description": "Every E/F event in the last 24 h, deduplicated ones included. Measured baseline was ~7 MB/day of error text, of which one benign WebView sandbox signature ('failed to create Unix domain socket') was 31 occurrences in 61 s — a high number here is not automatically a problem, a CHANGE in it is.",
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "beacon-vm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 5000
              },
              {
                "color": "red",
                "value": 50000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(stick_errors_total{serial=\"$serial\"}[24h]))",
          "instant": true
        }
      ]
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Unparsed lines, last 24 h",
      "description": "The format-change canary (§3.4 rule 2). Unparsed lines ALWAYS ship to Loki, so nothing is lost — but a rising rate means logcat is emitting a shape the parser does not know, usually after an app or OS update. A sustained non-zero climb here is the signal to go look at the raw lines, which are in the Logs panel under level=unparsed.",
      "gridPos": {
        "x": 8,
        "y": 51,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "beacon-vm"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 100
              },
              {
                "color": "red",
                "value": 5000
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "auto",
